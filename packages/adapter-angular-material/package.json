{
  "name": "@s9rg/theme-adapter-angular-material",
  "version": "0.6.0",
  "description": "Angular Material theme adapter for Theme Compiler",
  "keywords": [
    "angular",
    "color",
    "material",
    "theme"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s9rg/ui-theme-builder.git",
    "directory": "packages/adapter-angular-material"
  },
  "homepage": "https://s9rg.github.io/ui-theme-builder/",
  "bugs": {
    "url": "https://github.com/s9rg/ui-theme-builder/issues"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "MATERIAL_COLOR_UTILITIES_LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap --external @s9rg/theme-compiler"
  },
  "dependencies": {
    "@s9rg/theme-compiler": "0.6.0"
  },
  "devDependencies": {
    "@material/material-color-utilities": "0.4.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  }
}
