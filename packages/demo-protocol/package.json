{
  "name": "@s9rg/theme-demo-protocol",
  "version": "0.5.0",
  "description": "Versioned preview protocol for the Theme Compiler workbench",
  "keywords": [
    "design-tokens",
    "preview",
    "protocol",
    "theme"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s9rg/ui-theme-builder.git",
    "directory": "packages/demo-protocol"
  },
  "homepage": "https://s9rg.github.io/ui-theme-builder/",
  "bugs": {
    "url": "https://github.com/s9rg/ui-theme-builder/issues"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap"
  },
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  }
}
